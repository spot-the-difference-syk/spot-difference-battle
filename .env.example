# 로컬 개발용 Node 서버(apps/server) 설정입니다. 운영은 Cloudflare Worker이며
# 운영 설정은 workers/realtime/wrangler.toml 과 docs/CLOUDFLARE_DEPLOYMENT.md 를 봅니다.
HOST=0.0.0.0
PORT=3001

# 개발 모드에서는 Vite와 API 서버가 서로 다른 포트를 사용합니다.
WEB_ORIGIN=http://localhost:5173
VITE_SERVER_URL=http://localhost:3001

# 선택 사항: 비우면 등록된 장면 중 하나를 무작위로 사용합니다.
GAME_SCENE_ID=

# Supabase Dashboard > Connect에서 복사한 서버용 PostgreSQL 연결 문자열입니다.
# 프로젝트: usigggufvapufvbyugbr. 실제 비밀번호는 이 파일이나 Git에 기록하지 않습니다.
SUPABASE_DB_URL=

# E2E 등 명시적인 로컬 테스트에서만 사용합니다.
# STORAGE_DRIVER=memory

# 기본값 code(앱 번들 그림). database는 활성 puzzle_catalog를 읽고 5분마다 다시 읽습니다.
# database일 때는 그림 주소를 만들 R2 전달 Worker 주소가 필요합니다.
# PUZZLE_CATALOG_SOURCE=database
# PUZZLE_ASSET_BASE_URL=https://spot-difference-r2-canary.spot-difference-9barcode.workers.dev
