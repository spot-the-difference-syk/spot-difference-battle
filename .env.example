HOST=0.0.0.0
PORT=3001

# 개발 모드에서는 Vite와 API 서버가 서로 다른 포트를 사용합니다.
WEB_ORIGIN=http://localhost:5173
VITE_SERVER_URL=http://localhost:3001

# 선택 사항: home-office 한 쌍만 Private R2 Worker에서 읽는 Delivery Canary URL입니다.
# 비우면 모든 퍼즐이 기존 Git/Vite 이미지를 사용합니다. 비밀값을 넣지 마세요.
VITE_R2_CANARY_BASE_URL=

# 운영 단일 서비스에서는 빌드된 웹 앱 경로만 지정하면 됩니다.
# WEB_ORIGIN과 VITE_SERVER_URL을 비우면 브라우저와 Socket.IO가 같은 도메인을 사용합니다.
WEB_ROOT=
GAME_ASSET_ROOT=

# 선택 사항: 비우면 등록된 장면 중 하나를 무작위로 사용합니다.
GAME_SCENE_ID=

# Supabase Dashboard > Connect에서 복사한 서버용 PostgreSQL 연결 문자열입니다.
# 프로젝트: usigggufvapufvbyugbr. 실제 비밀번호는 이 파일이나 Git에 기록하지 않습니다.
SUPABASE_DB_URL=

# E2E 등 명시적인 로컬 테스트에서만 사용합니다. production에서는 무시됩니다.
# STORAGE_DRIVER=memory

# Defaults to code. database loads and validates active puzzle_catalog rows at startup.
# PUZZLE_CATALOG_SOURCE=database
