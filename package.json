{
  "name": "spot-difference-battle",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:ait": "pnpm --filter @spot-battle/web build:ait",
    "build:cloudflare": "node scripts/build-cloudflare.mjs web",
    "build:ait:cloudflare": "node scripts/build-cloudflare.mjs ait",
    "deploy:cloudflare": "pnpm build:packages && pnpm build:cloudflare && pnpm --filter @spot-battle/realtime run deploy",
    "e2e:cloudflare": "playwright test --config playwright.cloudflare.config.ts",
    "build:packages": "pnpm --filter @spot-battle/shared --filter @spot-battle/game-core build",
    "db:push": "npx supabase@2.117.0 db push --linked",
    "db:migrations": "npx supabase@2.117.0 migration list --linked",
    "precheck": "pnpm build:packages",
    "check": "pnpm check:structure && pnpm -r --if-present check",
    "check:structure": "node scripts/check-repository-structure.mjs",
    "predev": "pnpm build:packages",
    "dev": "pnpm --parallel --filter @spot-battle/web --filter @spot-battle/server dev",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium firefox webkit",
    "puzzle": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/puzzle-publish.mjs",
    "setup": "pnpm install && pnpm build:packages",
    "pretest": "pnpm build:packages",
    "test": "pnpm test:r2-delivery && pnpm test:scripts && pnpm -r --if-present test",
    "test:r2-delivery": "node --test workers/r2-delivery/test/index.test.mjs",
    "test:scripts": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test scripts/puzzle-publish.test.mjs",
    "build:android:web": "pnpm --filter @spot-battle/web build",
    "copy:android:web": "node scripts/copy-android-web.mjs",
    "package:android:web": "pnpm build:android:web && pnpm copy:android:web"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@playwright/test": "^1.61.1",
    "pg": "^8.22.0",
    "sharp": "0.34.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "4.134.0"
  }
}
