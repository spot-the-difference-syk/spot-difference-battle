{
  "name": "spot-difference-battle",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:ait": "pnpm --filter @spot-battle/web build:ait",
    "build:packages": "pnpm --filter @spot-battle/shared --filter @spot-battle/game-core build",
    "db:push": "npx supabase@2.117.0 db push --linked",
    "db:migrations": "npx supabase@2.117.0 migration list --linked",
    "precheck": "pnpm build:packages",
    "check": "pnpm check:structure && pnpm -r --if-present check",
    "check:structure": "node scripts/check-repository-structure.mjs",
    "predev": "pnpm build:packages",
    "dev": "pnpm --parallel --filter @spot-battle/web --filter @spot-battle/server dev",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium firefox webkit",
    "r2:canary": "node scripts/r2-canary.mjs",
    "setup": "pnpm install && pnpm build:packages",
    "pretest": "pnpm build:packages",
    "test": "pnpm test:r2-delivery && pnpm -r --if-present test",
    "test:r2-delivery": "node --test workers/r2-delivery/test/index.test.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@playwright/test": "^1.61.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "4.134.0"
  }
}
